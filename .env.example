# ---------- 服务 ----------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 采集执行超时（秒），超时直接熔断返回 partial 结果
COLLECT_TIMEOUT=10
# 采集模式：auto（非 Linux 自动 mock）| real（强制真实）| mock（强制模拟，便于演示）
COLLECT_MODE=auto

# 允许采集的主机白名单，逗号分隔；* 表示不限制（仅限内网可信环境）
COLLECT_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 指标缓存 TTL（秒）
METRIC_CACHE_TTL=60
# 历史故障保留时长（秒），默认 180 天
INCIDENT_TTL=15552000

# ---------- 大模型 / Embedding ----------
# 支持 openai / azure / local_bge
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 本地 BGE（EMBEDDING_PROVIDER=local_bge 时生效）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- RAG ----------
# 向量召回与关键词召回的 RRF 融合权重
RRF_K=60
VECTOR_TOP_K=10
BM25_TOP_K=10
FINAL_TOP_K=5

# ---------- Dify（Agent 侧） ----------
DIFY_BASE_URL=http://localhost:80/v1
DIFY_API_KEY=app-xxxxxx
